# PressClass — required environment variables.
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Server-only. Required for credit RPC calls, fingerprint writes, payment webhooks.
# Get it from Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=ey...

# ------------------------------------------------------------
# AI providers
# ------------------------------------------------------------
# Default provider is `groq` (see lib/AI_API_Switch.ts).
GROQ_API_KEY=gsk_...
# Optional fallback — switch ACTIVE_PROVIDER in lib/AI_API_Switch.ts to use it.
GEMINI_API_KEY=

# Required only if the RAG chatbot (8_chatbot_rag.sql) is activated.
OPENAI_API_KEY=

# ------------------------------------------------------------
# Public site URL (used by sitemap, robots, metadata canonicals)
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pressclass.app

# ------------------------------------------------------------
# Anti-abuse
# ------------------------------------------------------------
# Salt used to hash IPs / emails in signup_fingerprints. Set to a long random
# string in production. Rotating this invalidates all existing fingerprints.
FINGERPRINT_SALT=change-me-to-a-long-random-string

# ------------------------------------------------------------
# Payments (to be wired up — Paystack & Flutterwave for Africa first)
# ------------------------------------------------------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=         # optional for non-Africa users

# Paystack Payment Links (Temporary setup)
NEXT_PUBLIC_PAYSTACK_LINK_TASTE=
NEXT_PUBLIC_PAYSTACK_LINK_STARTER=
NEXT_PUBLIC_PAYSTACK_LINK_POPULAR=
NEXT_PUBLIC_PAYSTACK_LINK_BULK=

